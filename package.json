{
  "name": "miaoleme",
  "version": "0.6.1",
  "description": "喵了么 - 桌面端桌宠小助手：喝水/久坐/会议/DDL 提醒、番茄钟、吃饭转盘、小游戏、养成",
  "main": "main.js",
  "scripts": {
    "start": "node launch.js",
    "start:direct": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.zerobreak.desktoppet",
    "productName": "喵了么",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "main.js",
      "launch.js",
      "lib/**/*",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "generation.config.example.json",
      "docs/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "zip",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ]
    }
  }
}